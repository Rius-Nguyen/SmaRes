# ==============================================================================
# SmaRes — Environment Variables Template
# Copy this file to `.env.local` and fill in your actual values.
# NEVER commit `.env` or `.env.local` with real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. App Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# ------------------------------------------------------------------------------
# 2. Database Configuration (MongoDB Atlas)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smares_db?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Authentication & Security (JWT + RBAC + Admin Bootstrap)
# ------------------------------------------------------------------------------
# Generate a 64-char hex secret, e.g.: openssl rand -hex 32
JWT_SECRET=replace-with-64-char-hex-secret
# Used by `node scripts/create-admin.cjs` to seed/update admin@smares.com
ADMIN_PASSWORD=replace-with-strong-admin-password

# ------------------------------------------------------------------------------
# 4. Payment Gateway (MoMo & VNPay Sandbox)
# Note: Values starting with `YOUR_` or `replace-with-` are treated as unset.
# ------------------------------------------------------------------------------
# MoMo Sandbox (https://developers.momo.vn/)
MOMO_PARTNER_CODE=YOUR_MOMO_PARTNER_CODE
MOMO_ACCESS_KEY=YOUR_MOMO_ACCESS_KEY
MOMO_SECRET_KEY=YOUR_MOMO_SECRET_KEY
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:3000/payment/result
MOMO_IPN_URL=http://localhost:3000/api/payments/momo-ipn

# VNPay Sandbox (https://sandbox.vnpayment.vn/devreg/)
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/result
# Optional public IPN URL (configure in VNPay Merchant Portal for webhook testing):
# VNPAY_IPN_URL=https://<your-ngrok-domain>/api/payments/vnpay-ipn

# VietQR NAPAS 247 (Dynamic QR for Banking Apps & MoMo)
# Defaults to MBBank (970422) / 5018082006 / NGUYEN NGOC THINH when left as YOUR_*.
# Use NEXT_PUBLIC_* so Client Components (DepositPaymentModal) can read custom overrides.
NEXT_PUBLIC_VIETQR_BANK_BIN=YOUR_VIETQR_BANK_BIN
NEXT_PUBLIC_VIETQR_ACCOUNT_NO=YOUR_VIETQR_ACCOUNT_NO
NEXT_PUBLIC_VIETQR_ACCOUNT_NAME=YOUR_VIETQR_ACCOUNT_NAME

# ------------------------------------------------------------------------------
# 5. Mailing Service (Resend API — Reservation Confirmation BR-RES-05)
# ------------------------------------------------------------------------------
# Optional in local sandbox: if left as `YOUR_RESEND_API_KEY`, emails log safely to console.
RESEND_API_KEY=YOUR_RESEND_API_KEY
EMAIL_FROM=SmaRes Restaurant <no-reply@smares.vn>

# ------------------------------------------------------------------------------
# 6. AI & Vector Search (Google Gemini Embedding Script)
# ------------------------------------------------------------------------------
# Required when running `node scripts/generateFoodEmbeddings.js` (gemini-embedding-001)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
